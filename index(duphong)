<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SlideCraft — Đặt làm bài thuyết trình chuyên nghiệp</title>
<meta name="description" content="Dịch vụ thiết kế bài thuyết trình chỉn chu, ấn tượng và chuẩn thẩm mỹ theo yêu cầu.">
<style>
:root{--bg:#f5f8ff;--panel:#ffffff;--muted:#5d6b85;--text:#14213d;--accent:#2563eb;--accent2:#0891b2;--line:#dce5f3}
*{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;background:radial-gradient(circle at 80% 0%,#e0edff 0,transparent 35%),var(--bg);color:var(--text);line-height:1.6}
a{color:inherit}.wrap{width:min(1120px,92%);margin:auto}.nav{display:flex;align-items:center;justify-content:space-between;padding:22px 0}.brand{font-size:1.2rem;font-weight:850;letter-spacing:-.04em}.brand span{color:var(--accent2)}.nav a{color:var(--muted);text-decoration:none;font-size:.95rem}
.hero{display:grid;grid-template-columns:1.15fr .85fr;gap:40px;align-items:center;padding:58px 0 74px}.eyebrow{display:inline-flex;border:1px solid #c8d9f7;background:#eaf2ff;border-radius:99px;padding:6px 12px;color:#1d4ed8;font-size:.82rem}.hero h1{font-size:clamp(2.5rem,5vw,4.7rem);line-height:1.05;letter-spacing:-.06em;margin:20px 0}.hero h1 em{font-style:normal;color:var(--accent2)}.lead{color:var(--muted);font-size:1.1rem;max-width:620px}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px}.btn{border:0;border-radius:13px;padding:13px 18px;font-weight:750;cursor:pointer;text-decoration:none;display:inline-flex;justify-content:center;align-items:center;gap:8px}.primary{background:linear-gradient(135deg,var(--accent),#6a5cff);color:white;box-shadow:0 10px 30px #6257ff35}.secondary{background:#ffffff;color:#1d4ed8;border:1px solid #cbd8eb}.preview{background:linear-gradient(150deg,#ffffff,#edf5ff);border:1px solid #d5e2f5;border-radius:26px;padding:25px;box-shadow:0 24px 70px #1e40af14;transform:rotate(1deg)}.preview-top{display:flex;justify-content:space-between;color:#64748b;font-size:.85rem}.slide{margin-top:20px;background:linear-gradient(135deg,#2563eb,#0891b2);border-radius:18px;aspect-ratio:4/3;padding:26px;display:flex;flex-direction:column;justify-content:space-between;color:#fff}.slide small{font-weight:800;letter-spacing:.13em}.slide h2{font-size:2rem;line-height:1.08;max-width:260px;margin:12px 0}.slide p{margin:0;opacity:.9}.mini-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:14px}.mini-stats div{background:#ffffff;border:1px solid #dce5f3;border-radius:12px;padding:12px;text-align:center}.mini-stats strong{display:block;font-size:1.2rem}.mini-stats span{color:var(--muted);font-size:.76rem}
section{padding:38px 0 66px}.section-head{text-align:center;max-width:650px;margin:0 auto 28px}.section-head h2{font-size:clamp(1.8rem,3vw,2.6rem);letter-spacing:-.04em;margin:0 0 8px}.section-head p{color:var(--muted);margin:0}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.card{background:#ffffff;border:1px solid var(--line);border-radius:20px;padding:22px;box-shadow:0 8px 24px #1e40af08;display:flex;flex-direction:column;justify-content:space-between}.card .tag{font-size:.78rem;color:var(--accent2);font-weight:800}.card h3{margin:8px 0}.price{font-size:1.8rem;font-weight:850;letter-spacing:-.04em}.price small{font-size:.85rem;color:var(--muted);font-weight:500;letter-spacing:0}.card p,.card li{color:var(--muted);font-size:.94rem}.card ul{padding-left:19px;margin:14px 0 20px;min-height:90px}.card ul li{margin-bottom:6px}.card .btn{width:100%;margin-top:auto}.featured{border-color:#2563eb;box-shadow:0 0 0 1px #2563eb20}
.how{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.step{padding:20px;border-radius:18px;background:#ffffff;border:1px solid var(--line)}.num{width:35px;height:35px;display:grid;place-items:center;border-radius:11px;background:#eaf2ff;color:#1d4ed8;font-weight:800}.step p{color:var(--muted);font-size:.94rem}
footer{border-top:1px solid var(--line);padding:26px 0;color:var(--muted);font-size:.9rem}.foot{display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap}
.modal-backdrop{position:fixed;inset:0;background:#0f172a99;display:none;align-items:center;justify-content:center;padding:18px;z-index:10;overflow:auto}.modal-backdrop.show{display:flex}.modal{width:min(590px,100%);background:#ffffff;border:1px solid #d4e0f2;border-radius:22px;padding:25px;box-shadow:0 30px 100px #0009;margin:auto}.modal-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}.modal h2{margin:0}.close{background:#eaf2ff;color:#1e3a8a;border:0;border-radius:10px;width:36px;height:36px;font-size:1.2rem;cursor:pointer}.modal-intro{color:var(--muted);margin:8px 0 18px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:13px}.field{display:flex;flex-direction:column;gap:6px}.field.full{grid-column:1/-1}.field label{font-size:.87rem;color:var(--text)}.field input,.field select,.field textarea{width:100%;border:1px solid #cbd8eb;background:#f8fbff;color:#14213d;border-radius:11px;padding:12px;font:inherit;outline:none}.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--accent)}.field textarea{min-height:90px;resize:vertical}
.giftcode-box{display:flex;gap:8px}.giftcode-box input{text-transform:uppercase}.giftcode-box button{padding:0 16px;background:#0891b2;color:white;border:0;border-radius:11px;font-weight:700;cursor:pointer;white-space:nowrap}
.total-box{background:#f3f7ff;border:1px solid #cbd8eb;border-radius:12px;padding:14px;margin:15px 0;display:flex;flex-direction:column;gap:6px}.total-row{display:flex;justify-content:space-between;align-items:center;font-size:.95rem}.total-row.final{font-size:1.15rem;font-weight:800;color:var(--accent2);border-top:1px dashed #cbd8eb;padding-top:6px;margin-top:2px}
.notice{font-size:.8rem;color:var(--muted);margin:10px 0}.success{display:none;border:1px solid #86d8c8;background:#e9fbf5;padding:13px;border-radius:12px;margin-top:12px}.success.show{display:block}.error{display:none;color:#b91c1c;font-size:.9rem;margin-top:10px}.error.show{display:block}.code-msg{font-size:.82rem;margin-top:4px}
@media(max-width:760px){.hero{grid-template-columns:1fr;padding:36px 0 50px}.preview{transform:none}.cards,.how{grid-template-columns:1fr}.hero h1{font-size:3rem}.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.nav{padding:17px 0}}
</style>
</head>
<body>
<header class="wrap nav"><div class="brand">Slide<span>Craft.</span></div><a href="#goi">Bảng giá &nbsp; ↓</a></header>
<main>
<div class="wrap hero">
  <div><span class="eyebrow">✦ Thiết kế slide theo yêu cầu</span><h1>Ý tưởng của bạn.<br><em>Slide thật cuốn.</em></h1><p class="lead">Biến nội dung khô khan thành bài trình chiếu bắt mắt, chỉn chu và giàu tính thuyết phục. Tiết kiệm thời gian với chi phí cực kỳ hợp lý.</p><div class="actions"><a class="btn primary" href="#goi">Xem gói dịch vụ <span>↗</span></a><a class="btn secondary" href="mailto:chiasefile9@gmail.com">Liên hệ qua Gmail</a></div></div>
  <div class="preview"><div class="preview-top"><span>SLIDE PREVIEW</span><span>01 / 08</span></div><div class="slide"><small>YOUR NEXT PRESENTATION</small><div><h2>Trình bày ý tưởng thật ấn tượng</h2><p>Rõ ràng · Hiện đại · Dễ theo dõi</p></div><small>SLIDECRAFT / 2026</small></div><div class="mini-stats"><div><strong>5k+</strong><span>Giá khởi điểm</span></div><div><strong>3 gói</strong><span>Dễ lựa chọn</span></div><div><strong>1:1</strong><span>Theo yêu cầu</span></div></div></div>
</div>

<section id="goi"><div class="wrap"><div class="section-head"><h2>Chọn gói dịch vụ phù hợp</h2><p>Thiết kế chỉn chu, đúng hạn và tối ưu cho từng mục đích thuyết trình.</p></div><div class="cards">
<article class="card">
  <div>
    <span class="tag">CƠ BẢN</span>
    <h3>Tinh gọn & Tối giản</h3>
    <div class="price">5.000đ <small>/ gói chuẩn (5 slide)</small></div>
    <p>Giải pháp nhanh gọn cho bài tập nhóm, báo cáo môn học ngắn hoặc chuẩn hóa slide có sẵn.</p>
    <ul>
      <li>Căn chỉnh bố cục, font chữ sạch đẹp</li><li>Phối màu hài hòa theo chủ đề</li><li>Hỗ trợ chỉnh sửa nội dung cơ bản</li><li>Tự động cộng 2.000đ/slide nếu thêm slide</li>
    </ul>
  </div>
  <button class="btn secondary" onclick="openOrder('Cơ bản',5000, 5)">Chọn gói này</button>
</article>

<article class="card featured">
  <div>
    <span class="tag">ĐƯỢC CHỌN NHIỀU NHẤT</span>
    <h3>Chuyên nghiệp & Đồng bộ</h3>
    <div class="price">15.000đ <small>/ gói chuẩn (10 slide)</small></div>
    <p>Được thiết kế riêng biệt, thẩm mỹ cao giúp bài thuyết trình nổi bật và ghi điểm tuyệt đối.</p>
    <ul>
      <li>Phong cách thiết kế hiện đại, sang trọng</li><li>Minh họa trực quan với icon và hình ảnh chất lượng</li><li>Bố cục đồng bộ chuẩn nhận diện</li><li>Ưu tiên tiến độ hoàn thành nhanh</li>
    </ul>
  </div>
  <button class="btn primary" onclick="openOrder('Nổi bật',15000, 10)">Chọn gói này</button>
</article>

<article class="card">
  <div>
    <span class="tag">NÂNG CAO</span>
    <h3>Sáng tạo & Độc bản</h3>
    <div class="price">30.000đ <small>/ gói chuẩn (20 slide)</small></div>
    <p>Dành cho bài bảo vệ khóa luận, thuyết trình dự án quan trọng hoặc đốn gục người nghe.</p>
    <ul>
      <li>Thiết kế cá nhân hóa theo nhận diện riêng</li><li>Infographic, biểu đồ và hiệu ứng chuyển cảnh mượt mà</li><li>Tư vấn cấu trúc nội dung hấp dẫn</li><li>Hỗ trợ chỉnh sửa chu đáo theo phản hồi</li>
    </ul>
  </div>
  <button class="btn secondary" onclick="openOrder('Nâng cao',30000, 20)">Chọn gói này</button>
</article>
</div></div></section>

<section><div class="wrap"><div class="section-head"><h2>Quy trình đặt hàng đơn giản</h2><p>Chỉ với vài bước dễ dàng để sở hữu bài thuyết trình ưng ý nhất.</p></div><div class="how">
<div class="step"><div class="num">1</div><h3>Lựa chọn nhu cầu</h3><p>Chọn gói dịch vụ phù hợp, nhập số lượng slide và mô tả sơ lược nội dung mong muốn.</p></div>
<div class="step"><div class="num">2</div><h3>Áp mã & Gửi đơn</h3><p>Nhập Giftcode giảm giá (nếu có) và gửi yêu cầu. Thông tin sẽ được ghi nhận tức thì.</p></div>
<div class="step"><div class="num">3</div><h3>Xác nhận & Nhận bài</h3><p>Liên hệ qua Gmail để thống nhất chi tiết và nhận sản phẩm hoàn thiện đúng hẹn.</p></div>
</div></div></section>
</main>

<footer><div class="wrap foot"><span>© 2026 SlideCraft. Dịch vụ làm bài thuyết trình theo yêu cầu.</span><a href="mailto:chiasefile9@gmail.com">chiasefile9@gmail.com</a></div></footer>

<div class="modal-backdrop" id="backdrop" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
<div class="modal"><div class="modal-head"><div><h2 id="modalTitle">Gửi yêu cầu đặt hàng</h2><div class="modal-intro">Điền thông tin bên dưới. Hệ thống tự động tính phí dựa trên số slide.</div></div><button class="close" onclick="closeOrder()" aria-label="Đóng">×</button></div>
<form id="orderForm"><div class="form-grid">
<div class="field"><label for="customer">Tên của bạn *</label><input id="customer" name="customer" required maxlength="100" placeholder="Tên / biệt danh"></div>
<div class="field"><label for="email">Email liên hệ *</label><input id="email" name="email" type="email" required maxlength="160" placeholder="ban@example.com"></div>
<div class="field"><label for="package">Gói dịch vụ</label><select id="package" name="package" onchange="onPackageChange()"><option value="Cơ bản">Cơ bản</option><option value="Nổi bật">Nổi bật</option><option value="Nâng cao">Nâng cao</option></select></div>
<div class="field"><label for="budget">Ngân sách dự kiến (đ)</label><input id="budget" name="budget" readonly style="background:#e9ecef; cursor:not-allowed;"></div>
<div class="field"><label for="slides">Số lượng slide *</label><input id="slides" name="slides" type="number" min="1" max="200" value="5" required oninput="updateTotalView()"></div>
<div class="field"><label for="deadline">Hạn cần hoàn thành</label><input id="deadline" name="deadline" type="date"></div>

<div class="field full">
  <label for="giftcode">Mã giảm giá (Giftcode)</label>
  <div class="giftcode-box">
    <input id="giftcode" name="giftcode" placeholder="Nhập mã (nếu có)">
    <button type="button" onclick="applyGiftcode()">Áp dụng</button>
  </div>
  <div class="code-msg" id="codeMsg"></div>
</div>

<div class="field full"><label for="topic">Chủ đề / yêu cầu chi tiết *</label><textarea id="topic" name="topic" required maxlength="3000" placeholder="Môn học, chủ đề, phong cách..."></textarea></div>
</div>

<div class="total-box">
  <div class="total-row"><span>Ngân sách tính toán:</span><strong id="initialTotal">5.000đ</strong></div>
  <div class="total-row" id="discountRow" style="display:none; color:#16a34a;"><span>Giảm giá:</span><strong id="discountAmount">0đ</strong></div>
  <div class="total-row final"><span>Thành tiền dự kiến:</span><strong id="finalTotal">5.000đ</strong></div>
</div>

<button class="btn primary" style="width:100%" type="submit" id="submitBtn">Gửi yêu cầu đặt hàng</button>
<div class="error" id="error"></div>
<div class="success" id="success"></div>
</form></div></div>

<script>
const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbz8LjvLNyMHWeBPEh7xVHVOpSnSQ4HZYyfznGSkvQH_M9PCg7E8RTLviaFW3aQZT8de/exec"; 

const packageConfig = {
  "Cơ bản": { basePrice: 5000, baseSlides: 5 },
  "Nổi bật": { basePrice: 15000, baseSlides: 10 },
  "Nâng cao": { basePrice: 30000, baseSlides: 20 }
};

let appliedDiscount = 0;
let appliedCode = '';

function openOrder(pkg, price, defaultSlides){
  document.getElementById('package').value = pkg;
  document.getElementById('slides').value = defaultSlides;
  resetGiftcode();
  updateTotalView();
  document.getElementById('backdrop').classList.add('show');
  document.body.style.overflow = 'hidden';
}

function closeOrder(){
  document.getElementById('backdrop').classList.remove('show');
  document.body.style.overflow = '';
}

function onPackageChange(){
  const pkg = document.getElementById('package').value;
  if(packageConfig[pkg]){
    document.getElementById('slides').value = packageConfig[pkg].baseSlides;
  }
  resetGiftcode();
  updateTotalView();
}

function updateTotalView(){
  const pkg = document.getElementById('package').value;
  const config = packageConfig[pkg] || { basePrice: 5000, baseSlides: 5 };
  const userSlides = parseInt(document.getElementById('slides').value) || config.baseSlides;
  
  let calculatedBudget = config.basePrice;
  if(userSlides > config.baseSlides){
    calculatedBudget += (userSlides - config.baseSlides) * 2000;
  }

  document.getElementById('budget').value = calculatedBudget;
  
  const final = Math.max(0, calculatedBudget - appliedDiscount);
  document.getElementById('initialTotal').textContent = calculatedBudget.toLocaleString('vi-VN') + 'đ';
  document.getElementById('finalTotal').textContent = final.toLocaleString('vi-VN') + 'đ';
  
  if(appliedDiscount > 0){
    document.getElementById('discountRow').style.display = 'flex';
    document.getElementById('discountAmount').textContent = '-' + appliedDiscount.toLocaleString('vi-VN') + 'đ';
  } else {
    document.getElementById('discountRow').style.display = 'none';
  }
}

function resetGiftcode(){
  appliedDiscount = 0;
  appliedCode = '';
  document.getElementById('giftcode').value = '';
  document.getElementById('discountRow').style.display = 'none';
  const msg = document.getElementById('codeMsg');
  msg.textContent = '';
}

async function applyGiftcode(){
  const code = document.getElementById('giftcode').value.trim();
  const budget = Number(document.getElementById('budget').value);
  const msg = document.getElementById('codeMsg');
  
  if(!code){ resetGiftcode(); updateTotalView(); return; }

  msg.textContent = 'Đang kiểm tra mã...';
  msg.style.color = '#5d6b85';

  try {
    const res = await fetch(SCRIPT_URL, {
      method: 'POST',
      body: JSON.stringify({ action: 'validateGiftcode', code: code, budget: budget })
    });
    const data = await res.json();

    if(data.valid){
      appliedDiscount = data.discount;
      appliedCode = data.code;
      msg.textContent = 'Đã áp dụng mã thành công! Giảm ' + data.discount.toLocaleString('vi-VN') + 'đ';
      msg.style.color = '#16a34a';
      updateTotalView();
    } else {
      appliedDiscount = 0;
      appliedCode = '';
      msg.textContent = data.message || 'Mã không hợp lệ hoặc đã hết hạn.';
      msg.style.color = '#b91c1c';
      updateTotalView();
    }
  } catch(e) {
    msg.textContent = 'Lỗi kết nối kiểm tra mã.';
    msg.style.color = '#b91c1c';
  }
}

document.getElementById('backdrop').addEventListener('click', e => { if(e.target.id === 'backdrop') closeOrder(); });
document.addEventListener('keydown', e => { if(e.key === 'Escape') closeOrder(); });

document.getElementById('orderForm').addEventListener('submit', async e => {
  e.preventDefault();
  const form = e.currentTarget;
  const formData = new FormData(form);
  const data = Object.fromEntries(formData.entries());
  
  data.action = 'submitOrder';
  data.budget = Number(document.getElementById('budget').value);
  data.giftcode = appliedCode;

  const err = document.getElementById('error');
  const ok = document.getElementById('success');
  const btn = document.getElementById('submitBtn');

  err.classList.remove('show');
  ok.classList.remove('show');
  btn.disabled = true;
  btn.textContent = 'Đang gửi yêu cầu...';

  try {
    const res = await fetch(SCRIPT_URL, {
      method: 'POST',
      body: JSON.stringify(data)
    });
    const result = await res.json();

    if(result.ok){
      ok.innerHTML = '<b>Gửi yêu cầu thành công!</b> Đơn hàng đã được lưu vào Google Sheets.';
      ok.classList.add('show');
      form.reset();
      resetGiftcode();
      setTimeout(closeOrder, 4000);
    } else {
      throw new Error(result.error || 'Có lỗi xảy ra.');
    }
  } catch(ex){
    err.textContent = ex.message || 'Không thể gửi đơn hàng.';
    err.classList.add('show');
  } finally {
    btn.disabled = false;
    btn.textContent = 'Gửi yêu cầu đặt hàng';
  }
});
</script>
</body>
</html>
