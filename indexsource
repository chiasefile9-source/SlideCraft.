<script>
'use strict';
const CONFIG = Object.freeze({
  scriptUrl: 'https://script.google.com/macros/s/AKfycbzro3wlcZumELP5gklmDmUyNrSeXLV1_uVqcYSQvFBrmpH-88ON_eNUe5CkWeXvukP9/exec',
  email: 'chiasefile9@gmail.com',
  canvaUrl: 'https://www.canva.com/design/DAHXzQuoxVw/ODnUMu7WlZmMWAbn7T62ZQ/view?utm_content=DAHXzQuoxVw&utm_campaign=designshare&utm_medium=link&utm_source=viewer'
});
const packageConfig = Object.freeze({
  'Cơ bản': {basePrice:5000,baseSlides:5,minSlides:5,maxSlides:8,title:'Tinh gọn & Tối giản',tag:'CƠ BẢN',summary:'Giải pháp gọn gàng cho bài tập nhóm, báo cáo ngắn hoặc chỉnh sửa slide có sẵn.',features:['Căn chỉnh bố cục, font chữ sạch đẹp','Phối màu hài hòa theo chủ đề','1 lượt chỉnh sửa miễn phí','Thời gian giao: 1–2 ngày']},
  'Chuyên nghiệp': {basePrice:15000,baseSlides:10,minSlides:10,maxSlides:15,title:'Chuyên nghiệp & Đồng bộ',tag:'ĐƯỢC CHỌN NHIỀU NHẤT',summary:'Thiết kế thẩm mỹ cao giúp bài thuyết trình nổi bật và dễ theo dõi.',features:['Phong cách thiết kế hiện đại','Minh họa bằng icon và hình ảnh','2 lượt chỉnh sửa miễn phí','Thời gian giao: 2–3 ngày']},
  'Nâng cao': {basePrice:30000,baseSlides:20,minSlides:20,maxSlides:200,title:'Sáng tạo & Độc bản',tag:'NÂNG CAO',summary:'Dành cho bảo vệ khóa luận, dự án quan trọng hoặc bài trình bày chuyên sâu.',features:['Thiết kế cá nhân hóa theo chủ đề','Infographic và biểu đồ','3 lượt chỉnh sửa miễn phí','Thời gian giao: 3–5 ngày']}
});
const $ = id => document.getElementById(id);
const dialog = $('orderDialog');
let appliedDiscount=0, appliedCode='', checkingCode=false, codeRequestToken=0, orderCloseTimer=null, lastFocus=null;
function money(n){return Math.max(0,Number(n)||0).toLocaleString('vi-VN')+'đ'}
function priceFor(pkg,slides){const c=packageConfig[pkg];return c.basePrice+Math.max(0,slides-c.baseSlides)*2000}
function getCalculatedBudget(){const pkg=$('package').value,c=packageConfig[pkg];let n=Number($('slides').value);if(!Number.isInteger(n))n=c.baseSlides;return priceFor(pkg,n)}
function renderPackages(){
 const root=$('packageCards'); root.replaceChildren();
 Object.entries(packageConfig).forEach(([name,c],i)=>{
  const article=document.createElement('article');article.className='card'+(i===1?' featured':'');
  const box=document.createElement('div'),tag=document.createElement('span'),h=document.createElement('h3'),price=document.createElement('div'),small=document.createElement('small'),p=document.createElement('p'),ul=document.createElement('ul'),button=document.createElement('button');
  tag.className='tag';tag.textContent=c.tag;h.textContent=c.title;price.className='price';price.append(document.createTextNode(money(c.basePrice)+' '));small.textContent='/ '+c.baseSlides+' slide';price.append(small);p.textContent=c.summary;
  [...c.features,`Giới hạn ${c.minSlides}–${c.maxSlides} slide; thêm slide +2.000đ/slide`].forEach(t=>{const li=document.createElement('li');li.textContent=t;ul.append(li)});
  box.append(tag,h,price,p,ul);button.type='button';button.className='btn '+(i===1?'primary':'secondary');button.textContent='Chọn gói này';button.addEventListener('click',()=>openOrder(name));article.append(box,button);root.append(article);
 });
 $('package').replaceChildren(...Object.keys(packageConfig).map(name=>{const o=document.createElement('option');o.value=name;o.textContent=name;return o}));
}
function setError(message){const el=$('error');el.textContent=message;el.classList.add('show');el.focus();el.scrollIntoView({behavior:'smooth',block:'nearest'})}
function clearError(){ $('error').textContent='';$('error').classList.remove('show') }
function setModalOpen(open){
 if(open){if(dialog.open)return;lastFocus=document.activeElement;dialog.showModal();$('customer').focus()}
 else if(dialog.open){dialog.close();if(lastFocus&&typeof lastFocus.focus==='function')lastFocus.focus()}
}
function openOrder(pkg='Chuyên nghiệp'){
 if(orderCloseTimer){clearTimeout(orderCloseTimer);orderCloseTimer=null}
 $('orderForm').reset();$('package').value=packageConfig[pkg]?pkg:'Chuyên nghiệp';
 const c=packageConfig[$('package').value];$('slides').min=c.minSlides;$('slides').max=c.maxSlides;$('slides').value=c.baseSlides;
 resetGiftcode(false);clearError();$('success').classList.remove('show');$('success').textContent='';updateTotalView();setModalOpen(true)
}
function closeOrder(){if(orderCloseTimer){clearTimeout(orderCloseTimer);orderCloseTimer=null}setModalOpen(false)}
function resetGiftcode(clearInput=true){
 codeRequestToken++;checkingCode=false;appliedDiscount=0;appliedCode='';
 if(clearInput)$('giftcode').value='';
 $('applyCodeBtn').disabled=false;$('discountRow').hidden=true;$('codeMsg').textContent='';updateTotalView()
}
function updateTotalView(){const budget=getCalculatedBudget();$('budget').value=money(budget);$('initialTotal').textContent=money(budget);$('finalTotal').textContent=money(Math.max(0,budget-appliedDiscount));$('discountRow').hidden=!(appliedDiscount>0);$('discountAmount').textContent='-'+money(appliedDiscount)}
function onPackageOrSlidesChanged(){
 const c=packageConfig[$('package').value];$('slides').min=c.minSlides;$('slides').max=c.maxSlides;
 const n=Number($('slides').value);$('slideHint').hidden=!(Number.isFinite(n)&&(n<c.minSlides||n>c.maxSlides));
 resetGiftcode(true);$('codeMsg').textContent='Gói hoặc số slide đã thay đổi. Vui lòng áp dụng lại Giftcode nếu cần.';updateTotalView()
}
async function postToScript(data){
 if(!CONFIG.scriptUrl||CONFIG.scriptUrl.includes('PASTE_NEW_'))throw new Error('Website chưa được cấu hình URL Apps Script. Vui lòng liên hệ quản trị viên.');
 const controller=new AbortController(), timer=setTimeout(()=>controller.abort(),15000);
 try{
  const response=await fetch(CONFIG.scriptUrl,{method:'POST',headers:{'Content-Type':'text/plain;charset=utf-8'},body:JSON.stringify(data),signal:controller.signal});
  const text=await response.text();let result;
  try{result=JSON.parse(text)}catch(_){throw new Error('Máy chủ trả về dữ liệu không hợp lệ. Vui lòng thử lại sau.')}
  if(!response.ok)throw new Error('Không thể kết nối máy chủ. Vui lòng thử lại sau.');
  if(result.ok===false&&!result.valid)throw new Error(result.error||result.message||'Yêu cầu không hợp lệ.');
  return result;
 }catch(e){if(e.name==='AbortError')throw new Error('Yêu cầu quá thời gian chờ (15 giây). Hãy kiểm tra kết nối mạng rồi thử lại.');if(e instanceof TypeError)throw new Error('Không thể kết nối máy chủ. Hãy kiểm tra mạng và thử lại.');throw e}
 finally{clearTimeout(timer)}
}
async function applyGiftcode(){
 const code=$('giftcode').value.trim().toUpperCase(), budget=getCalculatedBudget(), token=++codeRequestToken;
 if(!code){resetGiftcode(false);$('codeMsg').textContent='Vui lòng nhập mã giảm giá.';return}
 checkingCode=true;$('applyCodeBtn').disabled=true;$('codeMsg').textContent='Đang kiểm tra mã...';
 try{
  const data=await postToScript({action:'validateGiftcode',code,package:$('package').value,slides:Number($('slides').value)});
  if(token!==codeRequestToken)return;
  if(getCalculatedBudget()!==budget){resetGiftcode(false);$('codeMsg').textContent='Giá đã thay đổi, vui lòng áp lại mã';return}
  if(data.valid){const discount=Number(data.discount);if(!Number.isFinite(discount)||discount<=0)throw new Error('Mã giảm giá không hợp lệ.');appliedDiscount=Math.min(budget,discount);appliedCode=data.code||code;$('codeMsg').textContent='Đã áp dụng mã thành công! Giảm '+money(appliedDiscount)}
  else{appliedDiscount=0;appliedCode='';$('codeMsg').textContent=data.message||'Mã không hợp lệ hoặc đã hết hạn.'}
  updateTotalView()
 }catch(e){if(token===codeRequestToken){appliedDiscount=0;appliedCode='';updateTotalView();$('codeMsg').textContent=e.message||'Không kiểm tra được mã. Vui lòng thử lại.'}}
 finally{if(token===codeRequestToken){checkingCode=false;$('applyCodeBtn').disabled=false}}
}
$('package').addEventListener('input',()=>{const c=packageConfig[$('package').value];if(!c)return;$('slides').value=c.baseSlides;onPackageOrSlidesChanged()});
$('package').addEventListener('change',()=>{const c=packageConfig[$('package').value];if(c){$('slides').value=c.baseSlides;onPackageOrSlidesChanged()}});
$('slides').addEventListener('input',onPackageOrSlidesChanged);$('slides').addEventListener('change',()=>{
 const c=packageConfig[$('package').value];let n=Number($('slides').value);if(Number.isInteger(n)){$('slides').value=Math.max(c.minSlides,Math.min(c.maxSlides,n));}
 $('slideHint').hidden=true;updateTotalView()
});
$('applyCodeBtn').addEventListener('click',applyGiftcode);
$('giftcode').addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();applyGiftcode()}});
$('closeOrder').addEventListener('click',closeOrder);$('footerOrder').addEventListener('click',()=>openOrder('Chuyên nghiệp'));
dialog.addEventListener('click',e=>{if(e.target===dialog)closeOrder()});
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&dialog.open)closeOrder()});
$('orderForm').addEventListener('submit',async e=>{
 e.preventDefault();clearError();$('success').classList.remove('show');
 if(!$('orderForm').reportValidity())return;
 if($('website').value){setError('Không thể xử lý yêu cầu.');return}
 if(checkingCode){setError('Vui lòng chờ kiểm tra mã giảm giá hoàn tất.');return}
 const typedCode=$('giftcode').value.trim();
 if(typedCode&&(!appliedCode||typedCode.toUpperCase()!==appliedCode.toUpperCase())){setError('Bạn đã nhập Giftcode nhưng chưa áp dụng thành công. Hãy bấm “Áp dụng” trước khi gửi đơn.');$('giftcode').focus();return}
 const pkg=$('package').value,c=packageConfig[pkg],slides=Number($('slides').value);
 if(!Number.isInteger(slides)||slides<c.minSlides||slides>c.maxSlides){setError('Số slide vượt giới hạn của gói. Vui lòng chọn gói cao hơn hoặc điều chỉnh số slide.');$('slides').focus();return}
 const btn=$('submitBtn'),key=crypto.randomUUID?crypto.randomUUID():String(Date.now())+'-'+Math.random().toString(36).slice(2);
 const payload={action:'submitOrder',customer:$('customer').value,email:$('email').value,package:pkg,slides,deadline:$('deadline').value,topic:$('topic').value,giftcode:appliedCode,website:$('website').value,consent:$('consent').checked,idempotencyKey:key};
 btn.disabled=true;btn.textContent='Đang gửi yêu cầu...';
 try{
  const result=await postToScript(payload);
  if(!result.ok)throw new Error(result.error||'Gửi đơn hàng không thành công.');
  showOrderSuccess(result.orderCode);
  $('orderForm').reset();resetGiftcode();const fresh=packageConfig['Chuyên nghiệp'];$('package').value='Chuyên nghiệp';$('slides').min=fresh.minSlides;$('slides').max=fresh.maxSlides;$('slides').value=fresh.baseSlides;updateTotalView();
  if(orderCloseTimer)clearTimeout(orderCloseTimer);if(!result.orderCode)orderCloseTimer=setTimeout(()=>{orderCloseTimer=null;closeOrder()},4000)
 }catch(err){setError(err.message||'Không thể gửi đơn hàng. Nếu lỗi tiếp diễn, vui lòng liên hệ '+CONFIG.email+'.')}
 finally{btn.disabled=false;btn.textContent='Gửi yêu cầu đặt hàng'}
});
document.querySelectorAll('.external-link').forEach(a=>a.href=CONFIG.canvaUrl);
document.querySelectorAll('.email-link').forEach(a=>a.href='mailto:'+CONFIG.email);
const today=new Date();today.setMinutes(today.getMinutes()-today.getTimezoneOffset());$('deadline').min=today.toISOString().slice(0,10);
renderPackages();$('package').value='Chuyên nghiệp';$('slides').min=1;$('slides').max=15;$('slides').value=10;updateTotalView();

/* ===== Cập nhật đơn hàng bằng mã đơn ===== */
const ORDER_CODE_STORE='sc_last_order_code';
const orderCodeStore={
 get(){try{return localStorage.getItem(ORDER_CODE_STORE)||''}catch(e){return ''}},
 set(v){try{localStorage.setItem(ORDER_CODE_STORE,v)}catch(e){}}
};
function normalizeOrderCode(v){const s=String(v||'').toUpperCase();const m=s.match(/SC[\s-]?([A-Z0-9]{8})/);return m?'SC-'+m[1]:s.replace(/\s+/g,'').slice(0,30)}
function showOrderSuccess(code){
 const box=$('success');box.replaceChildren();
 const p=document.createElement('div');p.textContent='Gửi yêu cầu thành công! Vui lòng chờ email xác nhận.';box.append(p);
 if(code){
  orderCodeStore.set(code);
  const note=document.createElement('div');note.textContent='Hãy lưu lại mã đơn hàng này. Bạn có thể dán mã vào mục “Cập nhật đơn hàng” để chỉnh sửa đơn khi cần:';note.style.marginTop='8px';
  const chip=document.createElement('div');chip.className='code-chip';
  const c=document.createElement('code');c.textContent=code;
  const copy=document.createElement('button');copy.type='button';copy.textContent='Sao chép';
  copy.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(code);copy.textContent='Đã sao chép ✓'}catch(e){const r=document.createRange();r.selectNodeContents(c);const sel=getSelection();sel.removeAllRanges();sel.addRange(r);copy.textContent='Hãy nhấn Ctrl+C'}});
  const edit=document.createElement('button');edit.type='button';edit.textContent='Cập nhật đơn này';
  edit.addEventListener('click',()=>{closeOrder();openUpdate(code)});
  chip.append(c,copy,edit);box.append(note,chip);
 }
 box.classList.add('show');box.focus();
}
const updDialog=$('updateDialog'),lookupForm=$('lookupForm'),updForm=$('updateForm');
let currentOrder=null,verifiedEmail='',updLastFocus=null;
function setMsg(id,text){const el=$(id);el.textContent=text||'';el.classList.toggle('show',!!text);if(text){el.focus();el.scrollIntoView({behavior:'smooth',block:'nearest'})}}
function clearUpdateMsgs(){['lookupError','uError','uSuccess'].forEach(id=>{const el=$(id);el.textContent='';el.classList.remove('show')})}
function resetUpdateView(){currentOrder=null;verifiedEmail='';clearUpdateMsgs();lookupForm.hidden=false;updForm.hidden=true;$('lookupBtn').disabled=false;$('lookupBtn').textContent='Tra cứu đơn hàng'}
function openUpdate(code){
 if(orderCloseTimer){clearTimeout(orderCloseTimer);orderCloseTimer=null}
 if(dialog.open)closeOrder();
 updLastFocus=document.activeElement;resetUpdateView();
 $('lookupCode').value=normalizeOrderCode(code||orderCodeStore.get());
 if(!updDialog.open)updDialog.showModal();
 ($('lookupCode').value?$('lookupEmail'):$('lookupCode')).focus();
}
function closeUpdate(){if(updDialog.open){updDialog.close();if(updLastFocus&&typeof updLastFocus.focus==='function')updLastFocus.focus()}}
function updateEditView(){
 const o=currentOrder;if(!o)return;
 const pkg=$('uPackage').value,c=packageConfig[pkg];if(!c)return;
 const n=Number($('uSlides').value);
 $('uSlideHint').hidden=!(Number.isFinite(n)&&(n<c.minSlides||n>c.maxSlides));
 const budget=Number.isInteger(n)?priceFor(pkg,n):c.basePrice;
 $('uBudget').value=money(budget);$('uInitialTotal').textContent=money(budget);
 const unchanged=pkg===o.package&&n===o.slides;
 $('uDiscountRow').hidden=!o.giftcode;
 if(o.giftcode){
  $('uDiscountLabel').textContent='Giảm giá ('+o.giftcode+'):';
  if(unchanged){$('uDiscountAmount').textContent='-'+money(o.discount);$('uFinalTotal').textContent=money(o.finalAmount)}
  else{$('uDiscountAmount').textContent='Tính lại khi lưu';$('uFinalTotal').textContent='Cập nhật sau khi lưu'}
 }else{$('uFinalTotal').textContent=money(budget)}
}
function fillUpdateForm(o){
 currentOrder=o;clearUpdateMsgs();
 $('uCode').textContent=o.orderCode;
 const st=$('uStatus');st.textContent=o.status;st.classList.toggle('locked',!o.editable);
 $('uTimes').textContent='Tạo lúc '+o.createdAt+(o.updatedAt?' · Cập nhật '+o.updatedAt:'');
 const sel=$('uPackage');sel.replaceChildren(...Object.keys(packageConfig).map(name=>{const op=document.createElement('option');op.value=name;op.textContent=name;return op}));
 sel.value=packageConfig[o.package]?o.package:'Chuyên nghiệp';
 const c=packageConfig[sel.value];$('uSlides').min=c.minSlides;$('uSlides').max=c.maxSlides;$('uSlides').value=o.slides||c.baseSlides;
 $('uDeadline').value=o.deadline||'';$('uTopic').value=o.topic||'';
 $('uFields').disabled=!o.editable;$('uSaveBtn').hidden=!o.editable;
 $('uNotice').textContent=o.editable
  ?(o.giftcode?'Mã giảm giá '+o.giftcode+' của đơn được giữ nguyên; mức giảm sẽ được tính lại theo giá mới.':'Giá hiển thị là giá dự kiến. Vui lòng chờ email xác nhận trước khi thanh toán.')
  :'Đơn hàng đang ở trạng thái “'+o.status+'” nên không thể chỉnh sửa trực tuyến. Vui lòng liên hệ '+CONFIG.email+' để được hỗ trợ.';
 lookupForm.hidden=true;updForm.hidden=false;updateEditView();
 (o.editable?$('uTopic'):$('uBackBtn')).focus();
}
$('lookupCode').addEventListener('input',e=>{const m=e.target.value.toUpperCase().match(/SC[\s-]?[A-Z0-9]{8}/);if(m){const v=normalizeOrderCode(m[0]);if(e.target.value!==v)e.target.value=v}});
$('pasteCodeBtn').addEventListener('click',async()=>{
 try{const t=await navigator.clipboard.readText();if(!t.trim())throw new Error('empty');$('lookupCode').value=normalizeOrderCode(t);setMsg('lookupError','');$('lookupEmail').focus()}
 catch(e){setMsg('lookupError','Không đọc được clipboard. Hãy nhấn giữ hoặc dùng Ctrl+V để dán mã vào ô.');$('lookupCode').focus()}
});
lookupForm.addEventListener('submit',async e=>{
 e.preventDefault();clearUpdateMsgs();
 const code=normalizeOrderCode($('lookupCode').value),email=$('lookupEmail').value.trim();
 if(!/^SC-[A-Z0-9]{8}$/.test(code)){setMsg('lookupError','Mã đơn hàng không hợp lệ. Mã có dạng SC-XXXXXXXX.');$('lookupCode').focus();return}
 if(!$('lookupEmail').checkValidity()||!email){setMsg('lookupError','Vui lòng nhập email hợp lệ đã dùng khi đặt hàng.');$('lookupEmail').focus();return}
 const btn=$('lookupBtn');btn.disabled=true;btn.textContent='Đang tra cứu...';
 try{
  const r=await postToScript({action:'lookupOrder',orderCode:code,email});
  if(!r.ok||!r.order)throw new Error(r.error||'Không tìm thấy đơn hàng.');
  verifiedEmail=email;orderCodeStore.set(r.order.orderCode);fillUpdateForm(r.order);
 }catch(err){setMsg('lookupError',err.message||'Không tra cứu được đơn hàng. Vui lòng thử lại.')}
 finally{btn.disabled=false;btn.textContent='Tra cứu đơn hàng'}
});
$('uPackage').addEventListener('change',()=>{const c=packageConfig[$('uPackage').value];if(!c)return;$('uSlides').min=c.minSlides;$('uSlides').max=c.maxSlides;$('uSlides').value=c.baseSlides;updateEditView()});
$('uSlides').addEventListener('input',updateEditView);
$('uSlides').addEventListener('change',()=>{const c=packageConfig[$('uPackage').value];const n=Number($('uSlides').value);if(c&&Number.isInteger(n))$('uSlides').value=Math.max(c.minSlides,Math.min(c.maxSlides,n));updateEditView()});
$('uBackBtn').addEventListener('click',()=>{resetUpdateView();$('lookupCode').focus()});
updForm.addEventListener('submit',async e=>{
 e.preventDefault();clearUpdateMsgs();
 if(!currentOrder||!currentOrder.editable)return;
 if(!updForm.reportValidity())return;
 const pkg=$('uPackage').value,c=packageConfig[pkg],slides=Number($('uSlides').value),deadline=$('uDeadline').value,topic=$('uTopic').value.trim();
 if(!Number.isInteger(slides)||slides<c.minSlides||slides>c.maxSlides){setMsg('uError','Số slide vượt giới hạn của gói. Vui lòng chọn gói cao hơn hoặc điều chỉnh số slide.');$('uSlides').focus();return}
 if(!topic){setMsg('uError','Vui lòng điền chủ đề / yêu cầu chi tiết.');$('uTopic').focus();return}
 if(deadline&&deadline!==currentOrder.deadline&&deadline<$('deadline').min){setMsg('uError','Hạn hoàn thành không được là ngày đã qua.');$('uDeadline').focus();return}
 const btn=$('uSaveBtn');btn.disabled=true;btn.textContent='Đang lưu...';
 try{
  const r=await postToScript({action:'updateOrder',orderCode:currentOrder.orderCode,email:verifiedEmail,package:pkg,slides,deadline,topic});
  if(!r.ok||!r.order)throw new Error(r.error||'Cập nhật không thành công.');
  fillUpdateForm(r.order);
  setMsg('uSuccess','Đã cập nhật đơn hàng. Thành tiền hiện tại: '+money(r.order.finalAmount)+'. Vui lòng chờ email xác nhận từ SlideCraft.');
 }catch(err){setMsg('uError',err.message||'Không thể cập nhật đơn hàng. Nếu lỗi tiếp diễn, vui lòng liên hệ '+CONFIG.email+'.')}
 finally{btn.disabled=false;btn.textContent='Lưu cập nhật'}
});

$('footerUpdate').addEventListener('click',()=>openUpdate());$('fabUpdate').addEventListener('click',()=>openUpdate());
$('closeUpdate').addEventListener('click',closeUpdate);
updDialog.addEventListener('click',e=>{if(e.target===updDialog)closeUpdate()});


/* ===== Festive dialog 20/10 ===== */
(()=>{
 const FV={delay:1200,hideKey:'sc_fv_2010_hidden_until',endDate:'2027-12-31T23:59:59'};
 const pop=$('festiveDialog');if(!pop||new Date()>new Date(FV.endDate))return;
 const store={get(){try{return Number(localStorage.getItem(FV.hideKey))||0}catch(e){return 0}},set(v){try{localStorage.setItem(FV.hideKey,String(v))}catch(e){}}};
 function endOfToday(){const d=new Date();d.setHours(23,59,59,999);return d.getTime()}
 function closeFv(){if($('fvSkip').checked)store.set(endOfToday());if(pop.open)pop.close()}
 $('fvClose').addEventListener('click',closeFv);
 pop.addEventListener('click',e=>{if(e.target===pop)closeFv()});
 if(store.get()>Date.now())return;
 setTimeout(()=>{if(!dialog.open&&!updDialog.open&&!pop.open)pop.showModal()},FV.delay);
})();
</script>
